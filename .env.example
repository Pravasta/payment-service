# Contoh environment untuk payment-service.
# Salin ke .env (di-gitignore) lalu sesuaikan. Dibaca via godotenv saat development;
# di produksi env di-set langsung oleh orchestrator.

# App
APP_NAME=payment-service
APP_ENV=development            # development | production

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_READ_TIMEOUT=15s
SERVER_WRITE_TIMEOUT=15s

# Database (PostgreSQL)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=payment_service
DATABASE_SSLMODE=disable
DATABASE_MAX_OPEN_CONNS=25
DATABASE_MAX_IDLE_CONNS=5
DATABASE_CONN_MAX_LIFETIME=1h

# Security — kunci AES-GCM untuk enkripsi secret at-rest (detailed-design §9)
# Harus 64 karakter hex (32 byte). Wajib diisi di production; boleh kosong saat dev.
# Generate: openssl rand -hex 32
PAYMENTS_MASTER_KEY=

# DOKU
# PENTING: DOKU_SECRET_KEY = Secret Key Direct API/Checkout (mis. "SK-...") yang
# dipakai adapter untuk menandatangani request ke DOKU (HMAC). JANGAN diisi MCP
# server key (prefix "doku_...") — itu kredensial berbeda, hanya untuk DOKU MCP
# server (header Authorization Basic di config MCP), bukan untuk service ini.
DOKU_ENVIRONMENT=sandbox
DOKU_BASE_URL=https://api-sandbox.doku.com
DOKU_CLIENT_ID=
DOKU_SECRET_KEY=

# Observability — alamat listen endpoint /metrics pada WORKER (background job).
# API server mengekspos /metrics pada SERVER_PORT-nya; var ini khusus worker.
METRICS_ADDR=:9091
